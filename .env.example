# Base URL of the Armstat backend.
# `/api/*` requests are rewritten to `${NEXT_PUBLIC_BACKEND_URL}/*`.
# Inlined at BUILD time — must be set before `pnpm build`.
NEXT_PUBLIC_BACKEND_URL=https://backend.armstat.am

# Host that serves the admin panel. When set, admin routes are only reachable
# on this host (under clean, prefix-free URLs) and hidden everywhere else.
# Read at REQUEST time by src/proxy.ts, so it can change without a rebuild.
# In production set this to the real admin domain, e.g. admin.armstat.am
# For local dev, *.localhost resolves to 127.0.0.1 in Chrome/Firefox with no
# hosts-file edit: open the admin at http://admin.localhost:3000
# Leave unset to keep the admin panel at /admin on the same host.
ADMIN_HOST=admin.armstat.am
